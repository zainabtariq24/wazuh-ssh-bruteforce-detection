<!--
  Wazuh custom rules — SSH brute-force detection
  Install on the MANAGER: /var/ossec/etc/rules/local_rules.xml

  SSH failures decode via Wazuh's built-in sshd decoder and, on this build
  (Kali + modern OpenSSH via journald), classify as rule 5760. Rule 100100
  fires when 3 failures from the same source IP occur within 120s, and drives
  the active response (firewall-drop).

  Validate before restarting the manager — a malformed ruleset takes the whole
  manager down, not just the new rule:
      sudo /var/ossec/bin/wazuh-analysisd -t
-->
<group name="local,syslog,sshd,">

  <!--
    Correlation rule: N failures from one source IP inside a time window.

    frequency=3 / timeframe=120  → 3 failed logins within 120 seconds
    if_matched_sid 5760          → count only decoded sshd auth failures
    same_source_ip               → all 3 must come from the SAME attacker
    level=10                     → high enough to trigger active response

    NOTE: 5760 is correct for this build. Most tutorials use 5716; confirm the
    SID your own failures actually produce before relying on it (see
    docs/LESSONS.md #1) or this rule will silently never fire.
  -->
  <rule id="100100" level="10" frequency="3" timeframe="120">
    <if_matched_sid>5760</if_matched_sid>
    <same_source_ip />
    <description>SSHD brute force: 3 failed login attempts from same source IP $(srcip)</description>
    <group>authentication_failures,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>
