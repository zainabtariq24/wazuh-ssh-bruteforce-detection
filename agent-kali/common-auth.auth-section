# /etc/pam.d/common-auth — 'auth' section with pam_faillock wired in (AGENT / Kali)
# Back up first: sudo cp /etc/pam.d/common-auth /etc/pam.d/common-auth.bak
#
# While the account is locked, the 'preauth' line denies the attempt BEFORE the
# password is checked -> a correct password is refused for the full lock window.

auth    required                        pam_faillock.so preauth
auth    [success=1 default=ignore]      pam_unix.so nullok
auth    [default=die]                   pam_faillock.so authfail
auth    sufficient                      pam_faillock.so authsucc
auth    requisite                       pam_deny.so
auth    required                        pam_permit.so
auth    optional                        pam_cap.so
